<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>EmpressValuablesUncapped</AssemblyName>
    <RootNamespace>Empress.ValuablesUncapped</RootNamespace>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ValuablesUncappedCompat.cs" />
    <GameReference Include="$(BepInExDir)/**/*.dll" />
    <Reference Include="@(GameReference->'%(Filename)')">
      <HintPath>%(GameReference.FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEngineStubPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
